#!/usr/bin/env bash
# File: git-pub

set -e

# Function to prompt for required input
prompt() {
  local var_name="$1"
  local prompt_text="$2"
  local input=""

  while true; do
    read -e -p "$prompt_text: " input

    if [ -n "$input" ]; then
      printf -v "$var_name" '%s' "$input"
      break
    else
      echo "Error: the field cannot be empty."
    fi
  done
}

# Function to prompt for optional input
prompt_optional() {
  local var_name="$1"
  local prompt_text="$2"
  local input=""

  read -e -p "$prompt_text (Press enter to skip): " input
  printf -v "$var_name" '%s' "$input"
}

# Function to convert input to uppercase
to_uppercase() {
  echo "$1" | tr '[:lower:]' '[:upper:]'
}

# Mapping of icons for each commit type
get_icon() {
  case "$1" in
    FIX) echo "🔧" ;;
    UPDATE) echo "🔄" ;;
    ADD) echo "➕" ;;
    PARTIAL) echo "✳️" ;;
    *) echo "" ;;
  esac
}

# Prompt for the commit type
prompt COMMIT_TYPE "Enter the commit type (FIX, UPDATE, ADD, PARTIAL)"
COMMIT_TYPE=$(to_uppercase "$COMMIT_TYPE")

# Prompt for the task number (optional)
prompt_optional TASK_NUMBER "Enter the task number (if present)"

# Prompt for the commit title
prompt COMMIT_TITLE "Enter the commit title"

# Prompt for the commit body (optional)
prompt_optional COMMIT_BODY "Enter the commit body"

# Prompt for the version/tag (optional)
prompt_optional TAG_VERSION "Enter the version/tag to create (example: v1.2.3)"

ICON=$(get_icon "$COMMIT_TYPE")

# Build commit title cleanly
if [ -n "$TASK_NUMBER" ]; then
  COMMIT_MESSAGE="[$COMMIT_TYPE] $ICON | $TASK_NUMBER $COMMIT_TITLE"
else
  COMMIT_MESSAGE="[$COMMIT_TYPE] $ICON | $COMMIT_TITLE"
fi

# Git add
if ! git add .; then
  echo "Git add failed"
  exit 1
fi

# Git commit
if [ -n "$COMMIT_BODY" ]; then
  git commit -m "$COMMIT_MESSAGE" -m "$COMMIT_BODY"
else
  git commit -m "$COMMIT_MESSAGE"
fi

# Create tag only if a version/tag was provided
if [ -n "$TAG_VERSION" ]; then
  if git rev-parse "$TAG_VERSION" >/dev/null 2>&1; then
    echo "Tag '$TAG_VERSION' already exists locally."
    exit 1
  fi

  if git ls-remote --exit-code --tags origin "refs/tags/$TAG_VERSION" >/dev/null 2>&1; then
    echo "Tag '$TAG_VERSION' already exists on remote."
    exit 1
  fi

  git tag -a "$TAG_VERSION" -m "Release $TAG_VERSION"
  echo "Created tag: $TAG_VERSION"
fi

# Push branch and annotated tags
if [ -n "$TAG_VERSION" ]; then
  git push --follow-tags
else
  git push
fi

echo "Push successful"
