#!/bin/sh
# File: git-pub

set -e

SKIP_BUILD=false

print_help() {
  cat <<'EOF'
Usage: git-pub [options]

Options:
  -s, --skip-build, --no-build   Salta verifica PM (yarn/npm), install e build
  -h, --help                     Mostra questo aiuto
EOF
}

# ---- parse flags (sh-compatible) ----
while [ "$#" -gt 0 ]; do
  case "$1" in
    -s|--skip-build|--no-build) SKIP_BUILD=true; shift ;;
    -h|--help) print_help; exit 0 ;;
    --) shift; break ;;
    -*) echo "Unknown option: $1"; print_help; exit 1 ;;
    *) break ;;
  esac
done

# ---- utilities ----
prompt() {
  var_name=$1
  prompt_text=$2
  input=""
  while true; do
    # read -e -p è bash-specific; teniamo la sintassi usata dall'autore
    # shellcheck disable=SC2162
    read -e -p "$prompt_text: " input
    if [ -n "$input" ]; then
      eval "$var_name=\"\$input\""
      break
    else
      echo "Error: the field cannot be empty."
    fi
  done
}

prompt_optional() {
  var_name=$1
  prompt_text=$2
  input=""
  # shellcheck disable=SC2162
  read -e -p "$prompt_text (Press enter to skip): " input
  eval "$var_name=\"\$input\""
}

to_uppercase() {
  echo "$1" | tr '[:lower:]' '[:upper:]'
}

get_icon() {
  case $1 in
    FIX) echo "🔧";;
    UPDATE) echo "🔄";;
    ADD) echo "➕";;
    PARTIAL) echo "✳️";;
    *) echo "";;
  esac
}

# ---- prompts ----
prompt COMMIT_TYPE "Enter the commit type (FIX, UPDATE, ADD, PARTIAL)"
COMMIT_TYPE=$(to_uppercase "$COMMIT_TYPE")
prompt_optional TASK_NUMBER "Enter the task number (if present)"
prompt COMMIT_TITLE "Enter the commit title"
prompt_optional COMMIT_BODY "Enter the commit body"
ICON=$(get_icon "$COMMIT_TYPE")

# ---- PM + build (optional) ----
if [ "$SKIP_BUILD" != "true" ]; then
  if [ -f "yarn.lock" ]; then
    PM="yarn"
  elif [ -f "package-lock.json" ]; then
    PM="npm"
  else
    echo "Error: No yarn.lock or package-lock.json found to determine package manager."
    exit 1
  fi

  # Install
  if [ "$PM" = "yarn" ]; then
    yarn install || { echo "Yarn install failed"; exit 1; }
  else
    npm install || { echo "NPM install failed"; exit 1; }
  fi

  # Build
  if [ "$PM" = "yarn" ]; then
    yarn build || { echo "Yarn build failed"; exit 1; }
  else
    npm run build || { echo "NPM build failed"; exit 1; }
  fi
fi

# Encrypt Trellis vaults when applicable
if ! TRELLIS_OUTPUT=$(trellis vault encrypt 2>&1); then
  if [[ "$TRELLIS_OUTPUT" != *"No Trellis project detected"* ]]; then
    printf '%s\n' "$TRELLIS_OUTPUT" >&2
    echo "Trellis vault encryption failed. Commit aborted."
    exit 1
  fi
elif [ -n "$TRELLIS_OUTPUT" ]; then
  printf '%s\n' "$TRELLIS_OUTPUT"
fi

# ---- git ops ----
git add . || { echo "Git add failed"; exit 1; }

# evita spazi doppi se TASK_NUMBER vuoto
COMMIT_PREFIX="[$COMMIT_TYPE] $ICON"
[ -n "$TASK_NUMBER" ] && COMMIT_PREFIX="$COMMIT_PREFIX | $TASK_NUMBER"

git commit -m "$COMMIT_PREFIX $COMMIT_TITLE" -m "$COMMIT_BODY" -m "DEPLOY" \
  || { echo "Git commit failed"; exit 1; }

git push || { echo "Git push failed"; exit 1; }

echo "Push successful"
